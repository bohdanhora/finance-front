# ---------------------------------------------------------------------------
# Base URL of the NestJS backend (no trailing slash).
# axios builds `${NEXT_PUBLIC_API_URL}/auth` and `${NEXT_PUBLIC_API_URL}/transactions`.
#   production: https://finance-backend-production-03b7.up.railway.app
#   local:      http://localhost:8000
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://finance-backend-production-03b7.up.railway.app

# Where the "Sign in with Google" button sends the browser.
# Must be the backend's GET /auth/google endpoint.
#   production: https://finance-backend-production-03b7.up.railway.app/auth/google
#   local:      http://localhost:8000/auth/google
NEXT_PUBLIC_OAUTH_URL=https://finance-backend-production-03b7.up.railway.app/auth/google

# Monobank public exchange-rate endpoint (UAH -> USD/EUR conversion).
# Same in every environment.
NEXT_PUBLIC_MONO_API_URL=https://api.monobank.ua/bank/currency
